{
  // TanStack Start app. Separate from the root tsconfig (Remix 3, jsxImportSource
  // remix/component) until the migration's cleanup phase removes app/.
  // verbatimModuleSyntax is intentionally off: Start warns it can leak server
  // bundles into client bundles.
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../vite.config.ts"]
}

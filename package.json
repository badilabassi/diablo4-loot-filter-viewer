    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "motion": "^12.42.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remix": "3.0.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@oxc-minify/binding-linux-arm64-gnu": "0.140.0",
    "@oxc-minify/binding-linux-x64-gnu": "0.140.0",

{
  // Tests for the TanStack Start app share src/'s React compiler settings.
  // test/remix/ is excluded: it tests the Remix app and runs under `remix test`.
  "extends": "../src/tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  // routeTree.gen.ts carries the module augmentation that types file routes
  // (createFileRoute paths, the `server` option) for tests importing route modules.
  "include": ["./**/*.ts", "./**/*.tsx", "../src/routeTree.gen.ts"],
  "exclude": ["./remix/**"]
}
